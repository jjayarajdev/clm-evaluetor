  "cards": [
    {
      "dot": "violet",
      "title": "Two Trigger Paths",
      "items": [
        "Indexing agents run inline per upload; deep analysis runs in the background after indexing completes",
        "Each deep stage uses its own DB session \u2014 one failure never rolls back earlier stages",
        "Ask AI runs on demand: the intent router picks structured handlers or RAG over ChromaDB"
      ]
    },
    {
      "dot": "cyan",
      "title": "Steered Extraction",
      "items": [
        "Detected language is injected into every agent prompt \u2014 French in, French out",
        "Tenant golden-set examples become few-shot context for clause, obligation and SLA agents",
        "Industry profiles add per-contract-type extraction hints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Robust by Contract",
      "items": [
        "Truncated JSON raises LLMTruncationError instead of reporting an empty result",
        "Clients carry timeout and retry budgets; every call is metered to usage_events",
        "Hierarchy suggestions run batch-scoped with content-hash-cached document cards"
      ]
    }
