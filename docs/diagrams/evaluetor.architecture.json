  "cards": [
    {
      "dot": "violet",
      "title": "Multi-Tenant Isolation",
      "items": [
        "Every query filters by tenant_id; business-unit visibility is derived",
        "DB-driven RBAC feeds backend guards and the frontend permission map",
        "JWT hardened: pinned algorithm, required claims, rate-limited login"
      ]
    },
    {
      "dot": "cyan",
      "title": "AI Pipeline",
      "items": [
        "Upload \u2192 parse \u2192 chunk \u2192 embed \u2192 extract metadata, clauses, obligations, risks, SLAs",
        "Language-aware extraction: French contracts produce French output",
        "Every LLM call is metered into usage_events for billing evidence"
      ]
    },
    {
      "dot": "amber",
      "title": "Data Residency Cells",
      "items": [
        "Each cell is a full stack on its own box; US cell live, EU cell prepped",
        "Cell-level OpenAI/Azure endpoint overrides route AI traffic in-region",
        "Integration credentials are Fernet-encrypted at rest"
      ]
    }
  ]
