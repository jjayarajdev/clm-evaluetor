# Template for the EU box's ~/clm/deploy/.env (per-box secrets — NEVER committed,
# rsync excludes .env). Copy to the EU box and fill values. Every secret must be
# DIFFERENT from the US cell — cells do not share credentials.
POSTGRES_USER=clm
POSTGRES_PASSWORD=            # fresh: openssl rand -hex 24
POSTGRES_DB=clm
OPENAI_API_KEY=               # EU LLM credential (Azure OpenAI key or EU OpenAI project key)
# If cell-level Azure endpoint lands (task #15): AZURE_OPENAI_ENDPOINT / deployment vars here
SECRET_KEY=                   # fresh: openssl rand -hex 32
JWT_SECRET_KEY=               # fresh: openssl rand -hex 32
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=          # separate EU Langfuse project
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # Langfuse EU region
PUBLIC_URL=https://app.eu.evaluetor.com
AWS_ACCESS_KEY_ID=            # EU-cell-scoped IAM user (SES/S3 backups), not the US one
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
SECURITY_PROFILE=enterprise
