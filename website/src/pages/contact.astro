---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Contact"
  description="Book a thirty-minute review with five of your live contracts. We will show you what your current CLM is missing."
>

<!-- HERO -->
<section class="section" style="padding-top: clamp(56px, 6vw, 100px); padding-bottom: clamp(28px, 3vw, 48px);">
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 items-baseline">
      <div class="col-span-12 md:col-span-3">
        <div class="label label-ink">Contact</div>
      </div>
      <div class="col-span-12 md:col-span-9">
        <h1 class="display display-xl" style="margin-top: 12px;">
          Bring five contracts. <span class="emph">Bring questions.</span><br/>
          We will bring findings.
        </h1>
        <p class="lead" style="margin-top: 24px; max-width: 640px;">
          A thirty-minute walkthrough with your real documents. No slides, no procurement involvement, no NDA required. Findings are yours to keep regardless of whether you proceed.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FORM + INFO -->
<section class="section sr" id="form" style="background: var(--surface); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);">
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-6 lg:gap-x-10 gap-y-10">

      <!-- Form -->
      <div class="col-span-12 lg:col-span-7">
        <div class="label label-ink" style="margin-bottom: 10px;">Get in touch</div>
        <h2 class="display display-md" style="margin-bottom: 28px;">Drop us a note.</h2>

        <form id="contact-form" action="/api/contact" method="post" novalidate style="display: grid; gap: 18px;">
          <!-- Honeypot: hidden from people, filled by bots. Any value = discarded server-side. -->
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" id="ts" value="" />
          <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 18px;">
            <div>
              <label class="label" for="name">Your name</label>
              <input type="text" id="name" name="name" required class="fld" />
            </div>
            <div>
              <label class="label" for="email">Work email</label>
              <input type="email" id="email" name="email" required class="fld" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 18px;">
            <div>
              <label class="label" for="company">Company</label>
              <input type="text" id="company" name="company" required class="fld" />
            </div>
            <div>
              <label class="label" for="role">Role</label>
              <input type="text" id="role" name="role" placeholder="e.g. Procurement Director" class="fld" />
            </div>
          </div>

          <div>
            <label class="label" for="message">What are you dealing with?</label>
            <textarea id="message" name="message" rows="5" placeholder="A few sentences about your portfolio, where you suspect leakage, or just what you want to see." class="fld"></textarea>
          </div>

          <p id="contact-error" class="form-msg error" role="alert" hidden></p>

          <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 6px;">
            <button type="submit" class="cta-btn" id="contact-submit">Send <span class="arr">→</span></button>
            <span class="ink-3" style="font-size: 13px;">Or email <a href="mailto:info@evaluetor.com" class="a-orange" style="font-size: 13px;">info@evaluetor.com</a> directly.</span>
          </div>
        </form>

        <div id="contact-success" class="form-msg success" role="status" hidden>
          <div class="label label-ink" style="margin-bottom: 8px;">Sent</div>
          <p style="font-size: 16px; margin: 0 0 6px;">Thanks — your note is with the Evaluetor team.</p>
          <p class="ink-3" style="font-size: 14px; margin: 0;">We reply from a real inbox, usually within one working day.</p>
        </div>
      </div>

      <!-- Info column -->
      <div class="col-span-12 lg:col-span-5">
        <div style="border: 1px solid var(--rule-2); padding: 28px; margin-bottom: 18px;">
          <div class="label label-ink" style="margin-bottom: 12px;">What a review looks like</div>
          <ul style="list-style: none; padding: 0; margin: 0;">
            <li style="padding: 10px 0; border-bottom: 1px solid var(--rule-2); font-size: 14.5px;"><span class="mono ink-3" style="font-size: 11px; margin-right: 10px;">01</span>You bring five live contracts. Any format.</li>
            <li style="padding: 10px 0; border-bottom: 1px solid var(--rule-2); font-size: 14.5px;"><span class="mono ink-3" style="font-size: 11px; margin-right: 10px;">02</span>We extract obligations, SLAs, risk patterns, renewals.</li>
            <li style="padding: 10px 0; border-bottom: 1px solid var(--rule-2); font-size: 14.5px;"><span class="mono ink-3" style="font-size: 11px; margin-right: 10px;">03</span>Findings are scored against portfolio norms — live.</li>
            <li style="padding: 10px 0; font-size: 14.5px;"><span class="mono ink-3" style="font-size: 11px; margin-right: 10px;">04</span>You keep the findings, regardless of next steps.</li>
          </ul>
        </div>

        <div style="border: 1px solid var(--rule-2); padding: 28px; margin-bottom: 18px;">
          <div class="label label-ink" style="margin-bottom: 12px;">Office</div>
          <p class="ink-2" style="font-size: 15px; margin-bottom: 6px; font-weight: 500;">Evaluetor B.V.</p>
          <p class="ink-3" style="font-size: 14px;">the Netherlands</p>
        </div>

        <div style="border: 1px solid var(--rule-2); padding: 28px;">
          <div class="label label-ink" style="margin-bottom: 12px;">Direct line</div>
          <a href="mailto:info@evaluetor.com" class="a-orange" style="font-size: 15px;">info@evaluetor.com <span class="arr">→</span></a>
        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  .fld {
    width: 100%;
    margin-top: 8px;
    padding: 11px 14px;
    background: var(--paper);
    border: 1px solid var(--rule-2);
    font-family: 'Geist', sans-serif;
    font-size: 15px;
    color: var(--ink);
    transition: border-color .15s ease, background .15s ease;
  }
  .fld:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--orange-2);
  }
  .fld::placeholder { color: var(--ink-4); }
  textarea.fld { resize: vertical; }
  .hp { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-msg { font-size: 14px; margin: 0; }
  .form-msg.error { color: var(--red); }
  .form-msg.success { border: 1px solid var(--rule-2); background: var(--paper); padding: 28px; }
  .cta-btn[disabled] { opacity: .6; cursor: default; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const ts = document.getElementById('ts') as HTMLInputElement | null;
  const errorBox = document.getElementById('contact-error') as HTMLElement | null;
  const successBox = document.getElementById('contact-success') as HTMLElement | null;
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (ts) ts.value = String(Date.now());

  const fallbackMailto = (data: Record<string, string>) => {
    const subject = encodeURIComponent(`Website enquiry — ${data.company} (${data.name})`);
    const body = encodeURIComponent(
      `Name: ${data.name}\nEmail: ${data.email}\nCompany: ${data.company}\nRole: ${data.role || '—'}\n\n${data.message || ''}`
    );
    return `mailto:info@evaluetor.com?subject=${subject}&body=${body}`;
  };

  const showError = (html: string) => {
    if (!errorBox) return;
    errorBox.innerHTML = html;
    errorBox.hidden = false;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submit) return;
    if (errorBox) errorBox.hidden = true;

    const data: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { data[k] = String(v); });

    submit.disabled = true;
    const label = submit.innerHTML;
    submit.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json().catch(() => ({}));

      if (res.ok && out.ok) {
        form.hidden = true;
        form.style.display = 'none'; // inline grid display would otherwise override [hidden]
        if (successBox) successBox.hidden = false;
        return;
      }
      if (res.status === 400 && out.error) {
        showError(out.error);
      } else {
        showError(
          `We couldn't send that just now. <a class="a-orange" href="${fallbackMailto(data)}">Send it from your mail client instead →</a>`
        );
      }
    } catch {
      showError(
        `We couldn't reach the server. <a class="a-orange" href="${fallbackMailto(data)}">Send it from your mail client instead →</a>`
      );
    } finally {
      submit.disabled = false;
      submit.innerHTML = label;
    }
  });
</script>

</MarketingLayout>
